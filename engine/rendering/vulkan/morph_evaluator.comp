#version 450
layout(local_size_x=64) in;
struct Slice { uint morph_id; uint offset_bytes; uint element_count; uint storage_mode; uint precision; };
struct Active { uint morph_id; float weight; };
layout(std430,set=0,binding=0) readonly buffer Base { vec4 base_positions[]; };
layout(std430,set=0,binding=1) writeonly buffer Output { vec4 output_positions[]; };
layout(std430,set=0,binding=2) readonly buffer Payload { uint payload[]; };
layout(std430,set=0,binding=3) readonly buffer Slices { Slice slices[]; };
layout(std430,set=0,binding=4) readonly buffer ActiveMorphs { Active active[]; };
layout(push_constant) uniform Params { uint vertex_count; uint slice_count; uint active_count; } params;
vec2 half2(uint v){return unpackHalf2x16(v);}
vec3 dense(uint o,uint v,uint p){if(p==0u){uint i=o/4u+v*3u;return vec3(uintBitsToFloat(payload[i]),uintBitsToFloat(payload[i+1u]),uintBitsToFloat(payload[i+2u]));}uint b=o+v*6u;uint i=b/4u;uint lane=(b&2u)/2u;vec2 a=half2(payload[i]);vec2 c=half2(payload[i+1u]);return lane==0u?vec3(a.x,a.y,c.x):vec3(a.y,c.x,c.y);}
vec3 sparse32(uint o,uint i,out uint target){uint p=o/4u+i*4u;target=payload[p];return vec3(uintBitsToFloat(payload[p+1u]),uintBitsToFloat(payload[p+2u]),uintBitsToFloat(payload[p+3u]));}
void main(){uint v=gl_GlobalInvocationID.x;if(v>=params.vertex_count)return;vec3 p=base_positions[v].xyz;for(uint a=0u;a<params.active_count;++a){for(uint s=0u;s<params.slice_count;++s){Slice sl=slices[s];if(sl.morph_id!=active[a].morph_id)continue;if(sl.storage_mode==0u)p+=dense(sl.offset_bytes,v,sl.precision)*active[a].weight;else if(sl.precision==0u){for(uint i=0u;i<sl.element_count;++i){uint t;vec3 d=sparse32(sl.offset_bytes,i,t);if(t==v){p+=d*active[a].weight;break;}}}break;}}output_positions[v]=vec4(p,1.0);}